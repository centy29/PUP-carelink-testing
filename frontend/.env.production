# Production build environment (loaded automatically by Vite during
# `npm run build` — i.e. inside the Docker build on Render).
# Local development keeps using .env, where VITE_API_URL is intentionally
# unset so the app resolves the backend dynamically (localhost:8000 / LAN IP).
VITE_API_URL=https://pup-carelink-testing-backend.onrender.com/api
VITE_APP_NAME="PUPBC CareLink"
