APP_NAME="PUPBC CareLink"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================
# DATABASE CONFIGURATION (Supabase - Pooler Connection)
# ============================================
# Using Supabase Connection Pooler (recommended for applications)
# Direct connection (db.rbrhhuisskfdienbkqao.supabase.co:5432) requires IPv6 support
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.rbrhhuisskfdienbkqao
DB_PASSWORD=
DB_SSLMODE=require

# ============================================
# SUPABASE CONFIGURATION
# ============================================
SUPABASE_URL=https://rbrhhuisskfdienbkqao.supabase.co
SUPABASE_KEY=
SUPABASE_ANON_KEY=

# ============================================
# CLINIC CONFIGURATION
# ============================================
SLOT_MAX=10
CLINIC_OPEN_TIME=08:00
CLINIC_CLOSE_TIME=17:00
LUNCH_START=12:00
LUNCH_END=13:00

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PER_MINUTE=60
KIOSK_RATE_LIMIT=30
AUTH_RATE_LIMIT=10

# ============================================
# MAIL CONFIGURATION (Gmail SMTP)
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=pupbccarelink@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=pupbccarelink@gmail.com
MAIL_FROM_NAME="PUPBC CareLink"

# ============================================
# CACHE & SESSION
# ============================================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ============================================
# SECURITY
# ============================================
JWT_SECRET=
JWT_TTL=1440
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ============================================
# REDIS (Optional - for production)
# ============================================
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379