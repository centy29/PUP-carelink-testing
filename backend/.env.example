APP_NAME="PUPBC CareLink"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pupbc_carelink_v3
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# CLINIC CONFIGURATION
# ============================================
SLOT_MAX=10
CLINIC_OPEN_TIME=08:00
CLINIC_CLOSE_TIME=17:00
LUNCH_START=12:00
LUNCH_END=13:00

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PER_MINUTE=60
KIOSK_RATE_LIMIT=30
AUTH_RATE_LIMIT=10

# ============================================
# MAIL CONFIGURATION (Gmail SMTP)
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=pupbccarelink@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=pupbccarelink@gmail.com
MAIL_FROM_NAME="PUPBC CareLink"

# ============================================
# CACHE & SESSION
# ============================================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ============================================
# SECURITY
# ============================================
JWT_SECRET=
JWT_TTL=1440
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ============================================
# REDIS (Optional - for production)
# ============================================
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379