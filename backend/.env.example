APP_NAME="PUPBC CareLink"
# ============================================================
# RENDER PRODUCTION DEFAULTS
# The Docker build copies this file to .env, so these values run
# on Render even when dashboard env vars are missing/incorrect.
# Local development: change APP_URL / FRONTEND_URL / DB_* back to
# your local values (or keep using your own backend/.env).
# ============================================================
APP_ENV=production
APP_KEY=base64:FFLV9AwzrAOZi9vmXL5z0WCk/NG5dKsnpW5uI4E671I=
APP_DEBUG=false
APP_URL=https://pup-carelink-testing-backend.onrender.com

# Frontend URL for CORS
FRONTEND_URL=https://pup-carelink-testing-frontend.onrender.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================
# DATABASE CONFIGURATION (Supabase - Pooler Connection)
# ============================================
# Using Supabase Connection Pooler (recommended for applications)
# Direct connection (db.rbrhhuisskfdienbkqao.supabase.co:5432) requires IPv6 support
DB_CONNECTION=pgsql
